@using MaktabBookStore.Domain.UserAgg.Enums
@using MaktabBookStore.Presentation.MVC.Models.ViewModels
@model MaktabBookStore.Presentation.MVC.Models.ViewModels.CombinedEditGetUserViewModel

@{
    Layout = "../Shared/_AdminLayout";
    ViewData["Title"] = "مدیریت کاربران";
}

<section class="max-w-6xl mx-auto space-y-8 px-6 py-10">

    <!-- Header -->
    <div class="flex items-center justify-between">
        <h2 class="text-2xl font-semibold text-indigo-700">لیست کاربران</h2>
        <a asp-controller="UsersManagement" asp-action="Create"
           class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-medium shadow transition-all duration-200">
            ➕ افزودن کاربر
        </a>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto bg-white shadow rounded-xl border border-gray-200">
        <table class="w-full text-sm text-gray-700 text-center border-collapse">
            <thead class="bg-indigo-50 text-gray-700 font-medium">
                <tr>
                    <th class="px-4 py-3 border-b">شناسه</th>
                    <th class="px-4 py-3 border-b">شماره موبایل</th>
                    <th class="px-4 py-3 border-b">نقش</th>
                    <th class="px-4 py-3 border-b">عملیات</th>
                </tr>
            </thead>

            <tbody>
                @if (Model?.Get?.Users != null && Model.Get.Users.Count > 0)
                {
                    @foreach (var user in Model.Get.Users)
                    {
                        <tr class="hover:bg-indigo-50 transition">
                            <td class="px-4 py-3 border-b">@user.Id</td>
                            <td class="px-4 py-3 border-b">@user.MobileNumber</td>
                            <td class="px-4 py-3 border-b">
                                @(user.Role == Role.Admin ? "ادمین" : "کاربر عادی")
                            </td>

                            <td class="px-4 py-3 border-b flex justify-center gap-2">
                                <a asp-controller="UsersManagement"
                                   asp-action="Update"
                                   asp-route-id="@user.Id"
                                   class="px-3 py-1 rounded-md bg-yellow-400 hover:bg-yellow-500 text-white font-medium text-sm shadow transition duration-200">
                                    ویرایش
                                </a>

                                <form asp-controller="UsersManagement"
                                      asp-action="DeleteConfirm"
                                      asp-route-id="@user.Id"
                                      method="post"
                                      onsubmit="return confirm('آیا از حذف این کاربر اطمینان دارید؟');"
                                      class="inline">
                                    <button type="submit"
                                            class="px-3 py-1 rounded-md bg-red-500 hover:bg-red-600 text-white font-medium text-sm shadow transition duration-200">
                                        حذف
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="px-4 py-6 text-gray-500">
                            هیچ کاربری ثبت نشده است.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</section>
