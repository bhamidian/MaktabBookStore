@using MaktabBookStore.Domain.UserAgg.Enums
@using MaktabBookStore.Presentation.MVC.Models.ViewModels
@model GetUserViewModel

@{
    Layout = "../Shared/_AdminLayout";
    ViewData["Title"] = "Update";
}

<section class="max-w-xl mx-auto bg-white p-6 rounded-xl shadow border border-gray-200 space-y-6">

  <div class="text-center">
    <h2 class="text-2xl font-bold text-indigo-700 mb-2">ویرایش مشخصات کاربر</h2>
  </div>

  <form method="post" action="/UsersManagement/Update" class="space-y-4">
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="grid grid-cols-1 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700">شناسه</label>
        <div class="mt-1 text-sm text-gray-600">@Model.Id</div>
      </div>

      <div>
        <label for="MobileNumber" class="block text-sm font-medium text-gray-700">شماره موبایل</label>
        <input id="MobileNumber" name="MobileNumber"
               value="@Model.MobileNumber"
               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm"
               placeholder="09xxxxxxxxx" />
      </div>

      <div>
        <label for="Password" class="block text-sm font-medium text-gray-700">رمز عبور</label>
        <input id="Password" name="Password"
               value="********"
               type="password"
               readonly
               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm bg-gray-100 text-gray-500 cursor-not-allowed" />
      </div>

      <div>
        <label for="Role" class="block text-sm font-medium text-gray-700">نقش</label>
        <select id="Role" name="Role" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
          @foreach (var r in Enum.GetValues(typeof(Role)).Cast<Role>())
          {
              <option>
                  @(r == Role.Admin ? "ادمین" :
                    r == Role.NormalUser ? "کاربر عادی" :
                    r.ToString())
              </option>
          }
        </select>
      </div>
    </div>

    <div class="flex justify-end space-x-2 space-x-reverse pt-3">
      <a href="@Url.Action("Index", "UsersManagement")"
         class="px-4 py-2 rounded-lg border border-gray-300 hover:bg-gray-100 transition text-gray-700 font-medium">
        بازگشت
      </a>

      <button type="submit"
              class="px-5 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-medium shadow transition">
        ذخیره تغییرات
      </button>
    </div>
  </form>

</section>
