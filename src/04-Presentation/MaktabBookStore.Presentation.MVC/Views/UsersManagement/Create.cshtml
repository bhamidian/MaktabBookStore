@using MaktabBookStore.Presentation.MVC.Models.ViewModels;
@model MaktabBookStore.Presentation.MVC.Models.ViewModels.CreateUserViewModel;


@{
    Layout = "../Shared/_AdminLayout";
    ViewData["Title"] = "Create";
}
 
  <body
    class="bg-gradient-to-tr from-blue-50 to-slate-50 min-h-screen text-gray-800 px-6 py-10"
  >
    <section class="max-w-lg mx-auto space-y-6">
      <!-- عنوان -->
      <div class="bg-white p-6 rounded-xl shadow border border-gray-200">
        <h2 class="text-2xl font-bold text-indigo-700 mb-6">
          ➕ افزودن کاربر جدید
        </h2>

        <form asp-action="Create" asp-controller="UsersManagement" method="post" class="space-y-4">
          <div>
            <label
              for="mobile"
              class="block text-sm font-medium text-gray-700 mb-1"
            >
              شماره موبایل
            </label>
            <input
              type="text"
              id="mobile"
              name="MobileNumber"
              placeholder=" 09123456789"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            />
          </div>

          <div>
            <label
              for="password"
              class="block text-sm font-medium text-gray-700 mb-1"
            >
              کلمه عبور
            </label>
            <input
              type="password"
              id="password"
              name="Password"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            />
          </div>

      
          <div>
            <span class="block text-sm font-medium text-gray-700 mb-1"
              >نقش کاربر</span
            >

            <div class="flex items-center space-x-4 space-x-reverse">
              <label
                class="flex items-center space-x-2 space-x-reverse cursor-pointer"
              >
                <input
                  type="radio"
                  name= "Role"
                  value="Admin"
                  class="accent-indigo-600 w-4 h-4 cursor-pointer"
                />
                <span class="text-gray-700 text-sm">ادمین</span>
              </label>

              <label
                class="flex items-center space-x-2 space-x-reverse cursor-pointer"
              >
                <input
                  type="radio"
                  name="Role"
                  value="NormalUser"
                  class="accent-indigo-600 w-4 h-4 cursor-pointer"
                />
                <span class="text-gray-700 text-sm">کاربر عادی</span>
              </label>
            </div>
          </div>

          <div class="pt-4 flex justify-end space-x-2 space-x-reverse">
            <a
            asp-action="Index"
            asp-controller="UsersManagement"
              class="px-4 py-2 rounded-lg border border-gray-300 hover:bg-gray-100 transition text-gray-600 font-medium"
            >
              بازگشت
            </a>
            <button
              id="submit"
              type="submit"
              class="px-5 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-medium shadow transition"
            >
              افزودن کاربر
            </button>
          </div>
        </form>
      </div>
    </section>
  </body>