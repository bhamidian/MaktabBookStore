
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - پنل مدیریت</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        body { font-family: 'Vazir', sans-serif; }
        .menu-item.active {
            background-color: #eef2ff;
            border-right: 4px solid #4f46e5;
            color: #312e81;
            font-weight: bold;
        }
    </style>
</head>

<body class="bg-slate-50 text-gray-800 flex min-h-screen">

    <!-- Sidebar -->
    <aside class="w-64 bg-white border-l border-indigo-100 shadow-sm flex flex-col">
        <div class="p-6 border-b border-gray-200 text-center font-bold text-indigo-700 text-xl">
            پنل مدیریت 📘
        </div>

        <ul class="menu flex flex-col text-gray-700 font-medium mt-4">
            <li>
                <a asp-controller="Admin" asp-action="Index" 
                   class="menu-item active flex items-center gap-2 px-6 py-3 hover:bg-indigo-50 border-r-4 border-transparent hover:border-indigo-400 transition">
                    <span class="text-indigo-600">🏠</span>
                    <p>خانه</p>
                </a>
            </li>
            <li>
                <a asp-controller="UsersManagement" asp-action="Index"
                   class="menu-item flex items-center gap-2 px-6 py-3 hover:bg-indigo-50 border-r-4 border-transparent hover:border-indigo-400 transition">
                    <span class="text-indigo-600">👥</span>
                    <p>مدیریت کاربران</p>
                </a>
            </li>
            <li>
                <a asp-controller="Admin" asp-action="Index"
                   class="menu-item flex items-center gap-2 px-6 py-3 hover:bg-indigo-50 border-r-4 border-transparent hover:border-indigo-400 transition">
                    <span class="text-indigo-600">📚</span>
                    <p>مدیریت کتاب‌ها</p>
                </a>
            </li>
            <li>
                <a asp-controller="Category" asp-action="Index"
                   class="menu-item flex items-center gap-2 px-6 py-3 hover:bg-indigo-50 border-r-4 border-transparent hover:border-indigo-400 transition">
                    <span class="text-indigo-600">🗂️</span>
                    <p>مدیریت دسته‌بندی‌ها</p>
                </a>
            </li>
            <li>
                <a asp-controller="Home" asp-action="Index"
                   class="menu-item flex items-center gap-2 px-6 py-3 hover:bg-red-50 border-r-4 border-transparent hover:border-red-400 transition">
                    <span class="text-red-500">🚪</span>
                    <p>خروج</p>
                </a>
            </li>
        </ul>
    </aside>

    <div class="flex-1 flex flex-col">
        <header class="bg-white shadow-sm px-6 py-4 flex justify-between items-center">
            <h1 class="text-lg font-semibold text-indigo-700">@ViewData["Title"]</h1>
            <div class="flex items-center gap-3 text-gray-600">
                <span class="text-sm">مدیر سیستم</span>
                <div class="bg-indigo-600 text-white w-10 h-10 flex items-center justify-center rounded-full font-bold">
                    M
                </div>
            </div>
        </header>

        <main class="flex-grow p-6">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="bg-indigo-50 border-t border-indigo-100 text-center py-4 text-sm text-gray-600">
            © 2025 باغ کتاب — بوت‌کمپ مکتب شریف
        </footer>
    </div>

</body>
</html>
