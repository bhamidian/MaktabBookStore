@using MaktabBookStore.Domain.BookAgg.DTOs
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using MaktabBookStore.Presentation.MVC.Models.ViewModels
@model MaktabBookStore.Presentation.MVC.Models.ViewModels.HomePageViewModel

@{
    string[] colors = { "#bed498", "#f6d186", "#f4976c", "#a8dadc", "#e5989b" };
    int i = 0;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>BookStore - صفحه اصلی</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-gray-800 font-sans">

    <!-- هدر -->
    <section class="text-center py-12 bg-gradient-to-l from-blue-100 to-indigo-100">
        <h1 class="text-3xl md:text-5xl font-extrabold text-indigo-700 mb-4">
            هر کتابی که می‌خواهی اینجاست 📚
        </h1>
        <h3 class="text-gray-700 mb-6">
            با بیش از <span class="font-bold text-indigo-600">۱۰۰٬۰۰۰</span> عنوان کتاب در دسته‌بندی‌های متنوع، سفر مطالعاتی خود را آغاز کنید.
        </h3>
        <a href="#"
           class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-2 rounded-lg shadow transition">
            مشاهده پرفروش‌ها
        </a>
    </section>

    <!-- دسته بندی‌ها -->
    <section class="py-10 px-4 md:px-8">
        <h2 class="text-2xl font-bold text-center mb-8 text-indigo-700">دسته‌بندی‌ها</h2>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6 justify-items-center">
            @foreach (var category in Model.Categories)
            {
                var color = colors[i % colors.Length];
                i++;
                <div class="w-32 h-32 flex flex-col items-center justify-center text-center rounded-xl shadow-md hover:shadow-lg transition transform hover:-translate-y-1"
                     style="background-color:@color;">
                    <a href="#" class="text-gray-800 font-semibold">
                        <span class="block text-4xl mb-2">@category.Logo</span>
                        <span>@category.CategoryName</span>
                    </a>
                </div>
            }
        </div>
    </section>

    <!-- جدیدترین کتاب‌ها -->
    <section class="py-12 px-4 md:px-8">
        <h2 class="text-2xl font-bold text-center mb-10 text-indigo-700">جدیدترین کتاب‌ها</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
            @foreach (var newbook in Model.Books)
            {
                <div class="bg-white rounded-xl overflow-hidden shadow-md hover:shadow-xl transition transform hover:-translate-y-1">
                    <div class="relative">
                        <img src="@newbook.ImagePath" alt="@newbook.Title" class="w-full h-60 object-cover" />
                        <div class="absolute bottom-0 w-full bg-gradient-to-t from-black/70 to-transparent text-white px-3 py-2">
                            <a href="#" class="font-semibold text-sm md:text-base">@newbook.Title</a>
                        </div>
                    </div>
                    <div class="p-4 space-y-1 text-gray-700 text-sm">
                        <div><span class="font-medium">✍️</span> @newbook.AuthorName</div>
                        <div><span class="font-medium">📄</span> @newbook.Pages صفحه</div>
                        <div class="font-bold text-indigo-600">@newbook.Price.ToString("N0") تومان</div>
                    </div>
                </div>
            }
        </div>
    </section>

</body>
</html>
