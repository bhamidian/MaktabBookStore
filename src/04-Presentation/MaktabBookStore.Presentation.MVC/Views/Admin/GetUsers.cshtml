@using MaktabBookStore.Presentation.MVC.Models.ViewModels;
@model MaktabBookStore.Presentation.MVC.Models.ViewModels.GetUserViewModel;


@{
    Layout = "../Shared/_AdminLayout";
    ViewData["Title"] = "GetUsers";
}
<body class="bg-gradient-to-tr from-blue-50 to-slate-50 min-h-screen text-gray-800 px-6 py-10">

  <section class="max-w-5xl mx-auto space-y-6">

    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-semibold text-indigo-700">لیست کاربران</h2>
      <a href="#افزودن" 
         class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-medium shadow transition">
        ➕ افزودن کاربر
      </a>
    </div>

    <div class="overflow-x-auto bg-white shadow rounded-xl border border-gray-200">
      <table class="w-full text-sm text-gray-700 text-center border-collapse">
        <thead class="bg-indigo-50 text-gray-700 font-medium">
          <tr>
            <th class="px-4 py-3 border-b">شماره موبایل</th>
            <th class="px-4 py-3 border-b">نقش</th>
            <th class="px-4 py-3 border-b">عملیات</th>
          </tr>
        </thead>
        <tbody>
        @for (int i = 0; i < Model.Users.Count;i++)
        {
            <tr class="hover:bg-indigo-50 transition">
            <td class="px-4 py-3 border-b">@Model.Users[i].MobileNumber</td>
            <td class="px-4 py-3 border-b">@Model.Users[i].Role</td>
            <td class="px-4 py-3 border-b space-x-1 space-x-reverse">
              <a href="#edit" 
                class="px-3 py-1 rounded-md bg-yellow-400 hover:bg-yellow-500 text-white font-medium text-sm transition">ویرایش</a>
              <a asp-action="DeleteUser" asp-controller="Admin" 
                class="px-3 py-1 rounded-md bg-red-500 hover:bg-red-600 text-white font-medium text-sm transition">حذف</a>
            </td>
          </tr>

        }


        </tbody>
      </table>
    </div>
  </section>

</body>
</html>
