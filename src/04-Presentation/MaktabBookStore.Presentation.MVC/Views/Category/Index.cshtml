@using MaktabBookStore.Presentation.MVC.Models.ViewModels;
@model MaktabBookStore.Presentation.MVC.Models.ViewModels.GetCategoriesViewModel;
@{
    Layout = "../Shared/_AdminLayout";
    ViewData["Title"] = "Index";
}
<body>
    

<section class="max-w-6xl mx-auto space-y-8 px-6 py-10">

    <div class="flex items-center justify-between">
        <h2 class="text-2xl font-semibold text-indigo-700">لیست دسته‌بندی‌ها</h2>
        <a asp-controller="Category" asp-action="Create"
           class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-medium shadow transition-all duration-200">
            ➕ افزودن دسته‌بندی
        </a>
    </div>

    <div class="overflow-x-auto bg-white shadow rounded-xl border border-gray-200">
        <table class="w-full text-sm text-gray-700 text-center border-collapse">
            <thead class="bg-indigo-50 text-gray-700 font-medium">
                <tr>
                    <th class="px-4 py-3 border-b">شناسه</th>
                    <th class="px-4 py-3 border-b">نام دسته‌بندی</th>
                    <th class="px-4 py-3 border-b">لوگو</th>
                    <th class="px-4 py-3 border-b">تعداد کتاب‌ها</th>
                    <th class="px-4 py-3 border-b">عملیات</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.GetCategories.Any())
                {
                    @foreach (var category in Model.GetCategories)
                    {
                        <tr class="hover:bg-indigo-50 transition">
                            <td class="px-4 py-3 border-b">@category.Id</td>
                            <td class="px-4 py-3 border-b">@category.CategoryName</td>
                            <td class="px-4 py-3 border-b">
                                @if (!string.IsNullOrEmpty(category.LogoPath))
                                {
                                    <img src="~/@category.LogoPath"
                                         alt="لوگو @category.CategoryName"
                                         class="h-10 w-10 object-cover mx-auto rounded-md border border-gray-300" />
                                }
                                else
                                {
                                    <span class="text-gray-400 italic">— ندارد —</span>
                                }
                            </td>
                            <td class="px-4 py-3 border-b">0</td>
                            <td class="px-4 py-3 border-b flex justify-center gap-2">
                                <a asp-controller="Category"
                                   asp-action="Edit"
                                   asp-route-id="@category.Id"
                                   class="px-3 py-1 rounded-md bg-yellow-400 hover:bg-yellow-500 text-white font-medium text-sm shadow transition">
                                    ویرایش
                                </a>

                                <form asp-controller="Category"
                                      asp-action="Delete"
                                      asp-route-id="@category.Id"
                                      method="post"
                                      onsubmit="return confirm('آیا از حذف این دسته‌بندی اطمینان دارید؟');"
                                      class="inline">
                                    <button type="submit"
                                            class="px-3 py-1 rounded-md bg-red-500 hover:bg-red-600 text-white font-medium text-sm shadow transition">
                                        حذف
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="px-4 py-6 text-gray-500">
                            هیچ دسته‌بندی ثبت نشده است.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
</body>
