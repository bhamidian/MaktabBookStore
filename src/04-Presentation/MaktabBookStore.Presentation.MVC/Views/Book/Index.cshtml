@using MaktabBookStore.Presentation.MVC.Models.ViewModels;
@model MaktabBookStore.Presentation.MVC.Models.ViewModels.GetBooksViewModel;


@{
    Layout = "../Shared/_AdminLayout";
    ViewData["Title"] = "Index";
}
  
  <body
    class="bg-gradient-to-tr from-blue-50 to-slate-50 min-h-screen text-gray-800 px-6 py-10"
  >
    <section class="max-w-6xl mx-auto space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-semibold text-indigo-700">لیست کتاب‌ها</h2>
        <a
          asp-controller="Book" asp-action="Create" 
          class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-medium shadow transition"
        >
          ➕ افزودن کتاب
        </a>
      </div>

      <div
        class="overflow-x-auto bg-white shadow rounded-xl border border-gray-200"
      >
        <table class="w-full text-sm text-gray-700 text-center border-collapse">
          <thead class="bg-indigo-50 text-gray-700 font-medium">
            <tr>
              <th class="px-4 py-3 border-b">نویسنده</th>
              <th class="px-4 py-3 border-b">موضوع</th>
              <th class="px-4 py-3 border-b">دسته‌بندی</th>
              <th class="px-4 py-3 border-b">طرح جلد</th>
              <th class="px-4 py-3 border-b">تعداد صفحات</th>
              <th class="px-4 py-3 border-b">قیمت (تومان)</th>
              <th class="px-4 py-3 border-b">عملیات</th>
            </tr>
          </thead>
          <tbody>
@foreach (var book in Model.GetBooks)
{
    <tr class="hover:bg-indigo-50 transition">
        <td class="px-4 py-3 border-b">@book.AuthorName</td>
        <td class="px-4 py-3 border-b">@book.Title</td>
        <td class="px-4 py-3 border-b">@book.CategoryName</td>
        <td class="px-4 py-3 border-b">
            <img
                src="@book.ImagePath"
                alt="طرح جلد"
                class="w-16 h-20 object-cover rounded shadow mx-auto"
            />
        </td>
        <td class="px-4 py-3 border-b">@book.Pages</td>
        <td class="px-4 py-3 border-b">@book.Price</td>
        <td class="px-4 py-3 border-b space-x-1 space-x-reverse">
            <a asp-controller="Book" asp-action="Edit" 
               class="px-3 py-1 rounded-md bg-yellow-400 hover:bg-yellow-500 text-white font-medium text-sm transition">
                ویرایش
            </a>
            <a asp-controller="Book" asp-action="Delete" 
               class="px-3 py-1 rounded-md bg-red-500 hover:bg-red-600 text-white font-medium text-sm transition">
                حذف
            </a>
        </td>
    </tr>
}
</tbody>



        

        </table>
      </div>
    </section>
  </body>