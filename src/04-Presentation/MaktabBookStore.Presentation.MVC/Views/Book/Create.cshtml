@using MaktabBookStore.Domain.CategoryAgg.Entities
@using MaktabBookStore.Presentation.MVC.Models.ViewModels;
@model MaktabBookStore.Presentation.MVC.Models.ViewModels.AddBookViewModel;


@{
    Layout = "../Shared/_AdminLayout";
    ViewData["Title"] = "Create";
}


<body class="bg-gradient-to-tr from-blue-50 to-slate-50 min-h-screen text-gray-800 px-6 py-10">

  <section class="max-w-3xl mx-auto bg-white p-8 rounded-xl shadow border border-gray-200 space-y-6">

    <h2 class="text-2xl font-bold text-indigo-700 mb-6 text-center">➕ افزودن کتاب جدید</h2>

    <form asp-action="Create" asp-controller="Book" method="post" enctype="multipart/form-data" class="space-y-5">

      <div>
        <label for="title" class="block text-sm font-medium text-gray-700 mb-1">نام کتاب</label>
        <input type="text" id="title" name="BookTitle" 
               class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
      </div>

<div>
  <label for="authorId" class="block text-sm font-medium text-gray-700 mb-1">دسته‌بندی</label>
  <select id="authorId" name="AuthorId"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
    @foreach (var a in Model.GetAuthors)
    {
        <option value="@a.Id")>
            @a.Name
        </option>
    }
  </select>
</div>

      <div>
        <label for="pagecount" class="block text-sm font-medium text-gray-700 mb-1">تعداد صفحات</label>
        <input type="number" id="pagecount" name="Pages" 
               class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
      </div>

      <div>
        <label for="price" class="block text-sm font-medium text-gray-700 mb-1">قیمت (تومان)</label>
        <input type="number" id="price" name="Price" 
               class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
      </div>

      <div>
        <label for="publishdate" class="block text-sm font-medium text-gray-700 mb-1">تاریخ انتشار</label>
        <input type="date" id="publishdate" name="PublishedDate"
               class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
      </div>

<div>
  <label for="categoryId" class="block text-sm font-medium text-gray-700 mb-1">دسته‌بندی</label>
  <select id="categoryId" name="CategoryId"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
    @foreach (var c in Model.GetCategories)
    {
        <option value="@c.Id")>
            @c.CategoryName
        </option>
    }
  </select>
</div>


      <div>
        <label for="img" class="block text-sm font-medium text-gray-700 mb-1">تصویر کتاب</label>
        <input type="file" id="img" name="ImagePath"
               accept="image/*"
               class="w-full border border-gray-300 rounded-lg px-3 py-2 cursor-pointer focus:ring-2 focus:ring-indigo-500 focus:outline-none">
      </div>

      <div class="pt-4 flex justify-end gap-3">
        <a asp-action="Index" asp-controller="Book"
           class="px-4 py-2 rounded-lg border border-gray-300 hover:bg-gray-100 text-gray-700 font-medium transition">
          بازگشت
        </a>
        <button type="submit"
                class="px-5 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-medium shadow transition">
          افزودن کتاب
        </button>
      </div>
    </form>

  </section>
</body>
